{
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "lib": ["DOM", "ESNext"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@apps4all/i18n": ["./packages/i18n"],
      "@apps4all/ui-components": ["./packages/ui-components"],
      "@apps4all/supabase-client": ["./packages/supabase-client"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "packages/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/*",
    "apps/web/dist"
  ]
}
