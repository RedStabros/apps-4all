  pt: {
    title: "Licença de Software e Propriedade Intelectual",
    subtitle: "Estrutura jurídica do Ecossistema 4All, restrições comerciais e reserva de direitos de venda futura.",
    lastUpdated: "Última Actualização: 10 de Setembro de 2026",
    backHome: "← Voltar ao Início",
    polyformAlertTitle: "Licença Regente: PolyForm Noncommercial License 1.0.0",
    polyformAlertDesc: "O código-fonte e os aplicativos do ecossistema 4All são publicados sob a licença PolyForm Noncommercial 1.0.0. O uso pessoal e não comercial é 100% gratuito. Qualquer comercialização ou revenda por terceiros é estritamente proibida.",
    sections: [
      {
        title: "1. Concessão de Licença Não Comercial",
        content: [
          "Sob a PolyForm Noncommercial License 1.0.0, é concedida uma licença gratuita e não comercial para baixar, usar e auditar os aplicativos 4All para fins pessoais e educativos."
        ]
      },
      {
        title: "2. Reserva de Propriedade Intelectual",
        content: [
          "Todos os direitos autorais, marcas e código-fonte pertencem exclusivamente ao Autor e Criador Original. Esta não é uma licença de código aberto permissiva (como MIT ou GPL)."
        ]
      },
      {
        title: "3. Proibições Comerciais",
        content: [
          "É estritamente proibido vender, sublicenciar ou monetizar este software por qualquer terceiro sem autorização prévia por escrito."
        ]
      },
      {
        title: "4. Reserva de Direitos de Venda Futura (M&A)",
        content: [
          "O Autor reserva-se o direito exclusivo de vender, transferir ou ceder a propriedade intelectual de qualquer um dos aplicativos individualmente ou de todo o ecossistema a investidores e adquirentes comerciais."
        ]
      }
    ]
  }
};

const t = translations[lang] || translations.en;
---

<Layout title={`${t.title} — 4All`} description={t.subtitle} lang={lang}>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-16 md:py-24 text-zinc-900 dark:text-zinc-100 transition-colors">
    <!-- Navegación de retorno -->
    <a
      href={`/${lang}/`}
      class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary dark:text-primary-dark hover:underline mb-8"
    >
      {t.backHome}
    </a>

    <!-- Encabezado -->
    <header class="mb-10">
      <div class="inline-flex items-center gap-2 p-3 bg-red-500/10 dark:bg-red-500/20 text-red-600 dark:text-red-400 rounded-2xl mb-5">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <span class="text-xs font-bold uppercase tracking-wider">PolyForm Noncommercial 1.0.0</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-zinc-900 dark:text-white mb-4">
        {t.title}
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 mb-3 leading-relaxed">
        {t.subtitle}
      </p>
      <p class="text-xs font-semibold text-zinc-500 dark:text-zinc-500">
        {t.lastUpdated}
      </p>
    </header>

    <!-- Alerta destacado de PolyForm Noncommercial -->
    <div class="p-6 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-900 dark:text-amber-200 mb-12">
      <div class="flex items-start gap-3">
        <span class="text-2xl flex-shrink-0">⚖️</span>
        <div>
          <h2 class="text-base font-bold mb-1">{t.polyformAlertTitle}</h2>
          <p class="text-sm leading-relaxed text-zinc-700 dark:text-amber-100/90">{t.polyformAlertDesc}</p>
        </div>
      </div>
    </div>

    <!-- Secciones Legales Estructuradas -->
    <div class="space-y-10">
      {t.sections.map((section) => (
        <section class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 shadow-sm">
          <h2 class="text-xl sm:text-2xl font-bold text-zinc-900 dark:text-white mb-4">
            {section.title}
          </h2>
          <div class="space-y-3 text-sm sm:text-base text-zinc-700 dark:text-zinc-300 leading-relaxed">
            {section.content.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- Pie de página de la licencia -->
    <div class="mt-14 pt-8 border-t border-zinc-200 dark:border-zinc-800 text-center text-xs text-zinc-500 dark:text-zinc-400">
      <p>Para Todos (4All) Ecosystem · Copyright © 2026. Todos los derechos reservados.</p>
    </div>
  </main>
</Layout>
