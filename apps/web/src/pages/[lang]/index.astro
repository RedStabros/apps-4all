    download_apk:       "APK डाउनलोड करा",
    stats_apps:         "15 अ‍ॅप्स",
    stats_languages:    "26 भाषा",
    stats_offline:      "100% ऑफलाइन",
    footer_tagline:     "सर्वांसाठी, सर्वत्र अ‍ॅप्स.",
  }

};

// Fallback to English
const t = (translations as Record<string, typeof translations.en>)[lang] ?? translations.en;

// ─────────────────────────────────────────────
//  App data from appsData.ts with localized summary
// ─────────────────────────────────────────────
const isEs = lang === 'es';
const appsMap = new Map(APPS_DATA.map(a => [a.slug, a]));

const productivityApps = [
  { slug: "apuntes-4all",           emoji: "📝" },
  { slug: "seguridad-4all",         emoji: "🔐" },
  { slug: "pdf-4all",               emoji: "📄" },
  { slug: "docs-4all",              emoji: "📊" },
  { slug: "notas-voz-4all",         emoji: "🎙️" },
].map(item => {
  const data = appsMap.get(item.slug)!;
  return {
    ...item,
    name: data.name,
    iconUrl: data.iconUrl,
    desc: isEs ? data.summary.es : data.summary.en,
    hasAccountOption: data.hasAccountOption,
    accountBadge: isEs ? data.accountBadge.es : data.accountBadge.en,
  };
});

const utilitiesApps = [
  { slug: "qr-4all",                 emoji: "📷" },
  { slug: "zip-4all",                emoji: "🗜️" },
  { slug: "fotos-ligeras-4all",      emoji: "🖼️" },
  { slug: "lupa-4all",               emoji: "🔦" },
  { slug: "reproductor-4all",        emoji: "🎵" },
].map(item => {
  const data = appsMap.get(item.slug)!;
  return {
    ...item,
    name: data.name,
    iconUrl: data.iconUrl,
    desc: isEs ? data.summary.es : data.summary.en,
    hasAccountOption: data.hasAccountOption,
    accountBadge: isEs ? data.accountBadge.es : data.accountBadge.en,
  };
});

const timeMathApps = [
  { slug: "enfoque-4all",            emoji: "⏱️" },
  { slug: "cuentas-4all",            emoji: "🧾" },
  { slug: "medidas-4all",            emoji: "📐" },
  { slug: "azar-4all",               emoji: "🎲" },
  { slug: "festivos-4all",           emoji: "📅" },
].map(item => {
  const data = appsMap.get(item.slug)!;
  return {
    ...item,
    name: data.name,
    iconUrl: data.iconUrl,
    desc: isEs ? data.summary.es : data.summary.en,
    hasAccountOption: data.hasAccountOption,
    accountBadge: isEs ? data.accountBadge.es : data.accountBadge.en,
  };
});

const apkBase = "https://github.com/RedStabros/apps-4all/releases/latest";
---

<Layout title={`${t.hero_title_1} ${t.hero_title_2} — 4All`} description={t.meta_desc} lang={lang}>

  <!-- ═══════════════════════════════════════════ -->
  <!--  SECTION 1: HERO                            -->
  <!-- ═══════════════════════════════════════════ -->
  <section class="relative min-h-[calc(100vh-4rem)] flex items-center justify-center overflow-hidden aurora-bg transition-colors duration-300">
    <!-- Dot pattern overlay -->
    <div class="absolute inset-0 dot-pattern pointer-events-none opacity-50 dark:opacity-40"></div>

    <!-- Radial glow accents -->
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-blue-500/10 dark:bg-blue-600/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-teal-500/10 dark:bg-teal-500/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute top-1/2 right-1/3 w-64 h-64 bg-amber-500/10 dark:bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Content -->
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center py-20">
      <!-- Eyebrow badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-zinc-900/5 dark:bg-white/10 backdrop-blur-sm border border-zinc-900/10 dark:border-white/20 text-zinc-700 dark:text-white/80 text-sm font-medium mb-8 animate-fade-in">
        <span class="w-2 h-2 rounded-full bg-teal-500 dark:bg-teal-400 animate-pulse"></span>
        4All Ecosystem · 2026
      </div>

      <!-- Main headline -->
      <h1 class="text-5xl sm:text-7xl lg:text-8xl font-extrabold text-zinc-900 dark:text-white leading-[1.05] tracking-tight mb-6 animate-fade-in">
        {t.hero_title_1}<br />
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-600 via-teal-500 to-amber-500 dark:from-blue-400 dark:via-teal-300 dark:to-amber-300">
          {t.hero_title_2}
        </span>
      </h1>

      <!-- Subtitle -->
      <p class="text-lg sm:text-xl text-zinc-600 dark:text-white/70 max-w-2xl mx-auto mb-10 leading-relaxed animate-fade-in">
        {t.hero_subtitle}
      </p>

      <!-- Feature badges -->
      <div class="flex flex-wrap items-center justify-center gap-3 mb-10 animate-fade-in">
        <span class="inline-flex items-center gap-2 px-4 py-2 bg-white/90 dark:bg-white/10 backdrop-blur-sm border border-zinc-200 dark:border-white/20 rounded-full text-zinc-800 dark:text-white text-sm font-semibold shadow-sm">
          <svg class="w-4 h-4 text-teal-600 dark:text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636a9 9 0 010 12.728M15.536 8.464a5 5 0 010 7.072M6.343 6.343a9 9 0 000 12.728M9.172 9.172a5 5 0 000 7.071M12 12h.01" /></svg>
          {t.badge_offline}
        </span>
        <span class="inline-flex items-center gap-2 px-4 py-2 bg-white/90 dark:bg-white/10 backdrop-blur-sm border border-zinc-200 dark:border-white/20 rounded-full text-zinc-800 dark:text-white text-sm font-semibold shadow-sm">
          <svg class="w-4 h-4 text-primary dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" /></svg>
          {t.badge_languages}
        </span>
        <span class="inline-flex items-center gap-2 px-4 py-2 bg-white/90 dark:bg-white/10 backdrop-blur-sm border border-zinc-200 dark:border-white/20 rounded-full text-zinc-800 dark:text-white text-sm font-semibold shadow-sm">
          <svg class="w-4 h-4 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          {t.badge_free}
        </span>
      </div>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-fade-in">
        <a
          href="#apps"
          id="hero-cta-primary"
          class="inline-flex items-center gap-2 px-8 py-3.5 bg-primary hover:bg-blue-700 dark:bg-white dark:hover:bg-zinc-100 text-white dark:text-zinc-900 font-bold rounded-2xl text-base transition-all duration-200 active:scale-95 shadow-xl"
        >
          {t.hero_cta}
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
        <a
          href="#why"
          id="hero-cta-secondary"
          class="inline-flex items-center gap-2 px-8 py-3.5 bg-white/80 hover:bg-white dark:bg-white/10 dark:hover:bg-white/20 backdrop-blur-sm text-zinc-800 dark:text-white font-semibold rounded-2xl text-base border border-zinc-200 dark:border-white/20 transition-all duration-200 active:scale-95 shadow-sm"
        >
          {t.hero_cta2}
        </a>
      </div>

      <!-- Scroll indicator -->
      <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 text-zinc-400 dark:text-white/40 animate-bounce">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ -->
  <!--  SECTION 2: PHILOSOPHY (WHY 4ALL)           -->
  <!-- ═══════════════════════════════════════════ -->
  <section id="why" class="py-24 bg-white dark:bg-zinc-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section header -->
      <div class="text-center mb-16 reveal">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-zinc-900 dark:text-white mb-4">
          {t.why_title}
        </h2>
      </div>

      <!-- 3 Pillars -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Privacy -->
        <div class="reveal reveal-delay-1 flex flex-col items-center text-center p-8 rounded-3xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-100 dark:border-zinc-800 hover:border-blue-200 dark:hover:border-blue-800 transition-colors duration-300 group">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center mb-6 shadow-lg group-hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-3">{t.why_privacy_title}</h3>
          <p class="text-zinc-500 dark:text-zinc-400 leading-relaxed text-sm">{t.why_privacy_desc}</p>
        </div>

        <!-- Offline -->
        <div class="reveal reveal-delay-2 flex flex-col items-center text-center p-8 rounded-3xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-100 dark:border-zinc-800 hover:border-teal-200 dark:hover:border-teal-800 transition-colors duration-300 group">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-teal-500 to-teal-700 flex items-center justify-center mb-6 shadow-lg group-hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636a9 9 0 010 12.728M15.536 8.464a5 5 0 010 7.072M6.343 6.343a9 9 0 000 12.728M9.172 9.172a5 5 0 000 7.071M12 12h.01" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-3">{t.why_offline_title}</h3>
          <p class="text-zinc-500 dark:text-zinc-400 leading-relaxed text-sm">{t.why_offline_desc}</p>
        </div>

        <!-- Global -->
        <div class="reveal reveal-delay-3 flex flex-col items-center text-center p-8 rounded-3xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-100 dark:border-zinc-800 hover:border-amber-200 dark:hover:border-amber-800 transition-colors duration-300 group">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center mb-6 shadow-lg group-hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-3">{t.why_global_title}</h3>
          <p class="text-zinc-500 dark:text-zinc-400 leading-relaxed text-sm">{t.why_global_desc}</p>
        </div>
      </div>

      <!-- Stats bar -->
      <div class="mt-16 reveal grid grid-cols-3 gap-4 p-6 rounded-3xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
        <div class="text-center">
          <div class="text-3xl font-extrabold text-primary dark:text-primary-dark mb-1">{t.stats_apps}</div>
          <div class="text-xs text-zinc-500 dark:text-zinc-400 font-medium uppercase tracking-widest">Apps</div>
        </div>
        <div class="text-center border-x border-zinc-200 dark:border-zinc-800">
          <div class="text-3xl font-extrabold text-teal-600 dark:text-teal-400 mb-1">{t.stats_languages}</div>
          <div class="text-xs text-zinc-500 dark:text-zinc-400 font-medium uppercase tracking-widest">Languages</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-extrabold text-amber-600 dark:text-amber-400 mb-1">{t.stats_offline}</div>
          <div class="text-xs text-zinc-500 dark:text-zinc-400 font-medium uppercase tracking-widest">Offline</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ -->
  <!--  SECTION 3+4: CATEGORIES + APP GRID         -->
  <!-- ═══════════════════════════════════════════ -->
  <section id="apps" class="py-24 bg-zinc-50 dark:bg-zinc-900/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Section header -->
      <div class="text-center mb-16 reveal">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-zinc-900 dark:text-white mb-3">
          {t.cat_section_title}
        </h2>
        <p class="text-zinc-500 dark:text-zinc-400">{t.cat_section_sub}</p>
      </div>

      <!-- ── PRODUCTIVITY ── -->
      <div class="mb-16">
        <div class="flex items-center gap-3 mb-8 reveal">
          <span class="w-3 h-3 rounded-full bg-primary"></span>
          <h3 class="text-xl font-bold text-zinc-900 dark:text-white">{t.cat_productivity}</h3>
          <span class="text-sm text-zinc-500 dark:text-zinc-400">— {t.cat_productivity_d}</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4">
          {productivityApps.map((app, i) => (
            <AppCard
              name={app.name}
              description={app.desc}
              apkUrl={`${apkBase}/${app.slug}/releases/latest`}
              category="productivity"
              emoji={app.emoji}
              iconUrl={app.iconUrl}
              slug={app.slug}
              lang={lang}
              hasAccountOption={app.hasAccountOption}
              accountBadge={app.accountBadge}
              index={i}
            />
          ))}
        </div>
      </div>

      <!-- ── UTILITIES ── -->
      <div class="mb-16">
        <div class="flex items-center gap-3 mb-8 reveal">
          <span class="w-3 h-3 rounded-full bg-teal-600 dark:bg-teal-400"></span>
          <h3 class="text-xl font-bold text-zinc-900 dark:text-white">{t.cat_utilities}</h3>
          <span class="text-sm text-zinc-500 dark:text-zinc-400">— {t.cat_utilities_d}</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4">
          {utilitiesApps.map((app, i) => (
            <AppCard
              name={app.name}
              description={app.desc}
              apkUrl={`${apkBase}/${app.slug}/releases/latest`}
              category="utilities"
              emoji={app.emoji}
              iconUrl={app.iconUrl}
              slug={app.slug}
              lang={lang}
              hasAccountOption={app.hasAccountOption}
              accountBadge={app.accountBadge}
              index={i}
            />
          ))}
        </div>
      </div>

      <!-- ── TIME & MATH ── -->
      <div>
        <div class="flex items-center gap-3 mb-8 reveal">
          <span class="w-3 h-3 rounded-full bg-amber-600 dark:bg-amber-400"></span>
          <h3 class="text-xl font-bold text-zinc-900 dark:text-white">{t.cat_time_math}</h3>
          <span class="text-sm text-zinc-500 dark:text-zinc-400">— {t.cat_time_math_d}</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4">
          {timeMathApps.map((app, i) => (
            <AppCard
              name={app.name}
              description={app.desc}
              apkUrl={`${apkBase}/${app.slug}/releases/latest`}
              category="time-math"
              emoji={app.emoji}
              iconUrl={app.iconUrl}
              slug={app.slug}
              lang={lang}
              hasAccountOption={app.hasAccountOption}
              accountBadge={app.accountBadge}
              index={i}
            />
          ))}
        </div>
      </div>
    </div>
  </section>

</Layout>
