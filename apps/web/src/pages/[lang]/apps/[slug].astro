---
// [slug].astro — Ficha técnica y manual detallado de cada app del ecosistema 4All
import Layout from '../../../layouts/Layout.astro';
import { APPS_DATA, type AppData } from '../../../data/appsData';

export function getStaticPaths() {
  const supportedLanguages = [
    'en', 'es', 'pt', 'it', 'tr', 'pl', 'hi', 'id',
    'ru', 'fr', 'de', 'zh-CN', 'zh-TW', 'ko', 'ja', 'vi', 'th',
    'bn', 'fil', 'sw', 'ha', 'ms', 'uk', 'ta', 'te', 'mr'
  ];

  const paths = [];
  for (const lang of supportedLanguages) {
    for (const app of APPS_DATA) {
      paths.push({
        params: { lang, slug: app.slug },
        props: { app, lang },
      });
    }
  }
  return paths;
}

interface Props {
  app: AppData;
  lang: string;
}

const { app, lang } = Astro.props;

// Diccionario de textos de interfaz
const ui = {
  es: {
    backToApps: 'Volver a todas las apps',
    breadcrumbHome: 'Inicio',
    breadcrumbApps: 'Apps',
    offlineBadge: '100% Sin Conexión',
    licenseBadge: 'Licencia PolyForm',
    downloadApk: 'Descargar APK Oficial',
    sectionManualTitle: '¿Qué puedes hacer con esta app? (Manual de Funciones)',
    sectionManualSub: 'Todas las herramientas operan de forma autónoma en el CPU de tu dispositivo.',
    sectionStepsTitle: 'Guía de Uso Paso a Paso',
    sectionAccountTitle: 'Estado de Cuenta y Sincronización',
    sectionPermissionsTitle: 'Permisos del Dispositivo y Privacidad',
    sectionSpecsTitle: 'Especificaciones Técnicas',
    relatedAppsTitle: 'Más herramientas de',
    permissionSafe: 'Privacidad garantizada: ningún dato sale de tu teléfono.',
    cloudSyncHeading: 'Sincronización Opcional',
    noAccountHeading: '100% Desconectado',
  },
  en: {
    backToApps: 'Back to all apps',
    breadcrumbHome: 'Home',
    breadcrumbApps: 'Apps',
    offlineBadge: '100% Offline',
    licenseBadge: 'PolyForm License',
    downloadApk: 'Download Official APK',
    sectionManualTitle: 'What can you do with this app? (Feature Manual)',
    sectionManualSub: 'All operations run autonomously on your local device CPU.',
    sectionStepsTitle: 'Step-by-Step User Guide',
    sectionAccountTitle: 'Account Status & Cloud Sync',
    sectionPermissionsTitle: 'Device Permissions & Privacy',
    sectionSpecsTitle: 'Technical Specifications',
    relatedAppsTitle: 'More tools in',
    permissionSafe: 'Guaranteed privacy: zero data ever leaves your device.',
    cloudSyncHeading: 'Optional Cloud Sync',
    noAccountHeading: '100% Local Utility',
  },
};

const isSpanish = lang === 'es';
const isEn = lang === 'en';
const t = (ui as any)[lang] ?? (isSpanish ? ui.es : ui.en);

const categoryConfig = {
  productivity: {
    label: isSpanish ? 'Productividad' : 'Productivity',
    accentColor: 'from-blue-600 to-indigo-600',
    borderAccent: 'border-blue-500/30',
    bgBadge: 'bg-blue-100 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 border-blue-200 dark:border-blue-800/50',
    heroGlow: 'shadow-blue-500/10',
    btn: 'bg-primary hover:bg-blue-700 dark:bg-primary-dark dark:hover:bg-blue-300 text-white dark:text-zinc-900',
  },
  utilities: {
    label: isSpanish ? 'Utilidades' : 'Utilities',
    accentColor: 'from-teal-600 to-emerald-600',
    borderAccent: 'border-teal-500/30',
    bgBadge: 'bg-teal-100 dark:bg-teal-950/60 text-teal-700 dark:text-teal-300 border-teal-200 dark:border-teal-800/50',
    heroGlow: 'shadow-teal-500/10',
    btn: 'bg-teal-600 hover:bg-teal-700 dark:bg-teal-400 dark:hover:bg-teal-300 text-white dark:text-zinc-900',
  },
  'time-math': {
    label: isSpanish ? 'Tiempo y Matemáticas' : 'Time & Math',
    accentColor: 'from-amber-600 to-orange-600',
    borderAccent: 'border-amber-500/30',
    bgBadge: 'bg-amber-100 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 border-amber-200 dark:border-amber-800/50',
    heroGlow: 'shadow-amber-500/10',
    btn: 'bg-amber-600 hover:bg-amber-700 dark:bg-amber-400 dark:hover:bg-amber-300 text-white dark:text-zinc-900',
  },
};

const cfg = categoryConfig[app.category];

// Contenido según idioma (español si es 'es', inglés para todos los demás)
const tagline = isSpanish ? app.tagline.es : app.tagline.en;
const summary = isSpanish ? app.summary.es : app.summary.en;
const accountBadge = isSpanish ? app.accountBadge.es : app.accountBadge.en;
const accountExplanation = isSpanish ? app.accountExplanation.es : app.accountExplanation.en;
const features = isSpanish ? app.features.es : app.features.en;
const manualSteps = isSpanish ? app.manualSteps.es : app.manualSteps.en;
const permissions = isSpanish ? app.permissions.es : app.permissions.en;

// Apps relacionadas de la misma categoría
const relatedApps = APPS_DATA.filter(a => a.category === app.category && a.slug !== app.slug);
---

<Layout
  title={`${app.name} — Manual de Funciones y Descarga · 4All`}
  description={`${tagline} ${summary}`}
  lang={lang}
>
  <main class="min-h-screen pt-24 pb-20 bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 transition-colors duration-300">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-zinc-500 dark:text-zinc-400 mb-8" aria-label="Breadcrumb">
        <a href={`/${lang}/`} class="hover:text-primary dark:hover:text-primary-dark transition-colors">{t.breadcrumbHome}</a>
        <span>/</span>
        <a href={`/${lang}/#apps`} class="hover:text-primary dark:hover:text-primary-dark transition-colors">{t.breadcrumbApps}</a>
        <span>/</span>
        <span class="text-zinc-800 dark:text-zinc-200 font-semibold">{app.name}</span>
      </nav>

      <!-- ═══════════════════════════════════════════ -->
      <!-- HERO: INFORMACIÓN PRINCIPAL DE LA APP       -->
      <!-- ═══════════════════════════════════════════ -->
      <header class="p-8 sm:p-10 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-xl mb-12 relative overflow-hidden">
        <!-- Glow ambiental -->
        <div class="absolute -top-24 -right-24 w-80 h-80 bg-gradient-to-br from-primary/10 to-teal-500/10 dark:from-primary/20 dark:to-teal-500/20 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 flex flex-col md:flex-row items-center md:items-start gap-8">
          <!-- Icono 96px Extra Grande con marco -->
          <div class="flex-shrink-0">
            <div class="w-28 h-28 sm:w-32 sm:h-32 rounded-3xl p-2 bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 shadow-xl flex items-center justify-center">
              <img
                src={app.iconUrl}
                alt={app.name}
                class="w-full h-full object-contain rounded-2xl drop-shadow-lg transform transition-transform hover:scale-105 duration-300"
              />
            </div>
          </div>

          <!-- Título, Badges y Resumen -->
          <div class="flex-1 text-center md:text-left">
            <!-- Badges -->
            <div class="flex flex-wrap items-center justify-center md:justify-start gap-2 mb-3">
              <span class:list={['text-xs font-semibold px-3 py-1 rounded-full border', cfg.bgBadge]}>
                {cfg.label}
              </span>

              <!-- Badge de Cuenta -->
              {app.hasAccountOption ? (
                <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800">
                  <svg class="w-3.5 h-3.5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z" />
                  </svg>
                  {accountBadge}
                </span>
              ) : (
                <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
                  <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                  {accountBadge}
                </span>
              )}

              <span class="inline-flex items-center gap-1 text-xs font-medium px-2.5 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700">
                ⚡ {t.offlineBadge}
              </span>
            </div>

            <!-- Nombre Canónico -->
            <h1 class="text-3xl sm:text-4xl font-extrabold text-zinc-900 dark:text-white tracking-tight mb-2">
              {app.name}
            </h1>
            <p class="text-base sm:text-lg text-primary dark:text-primary-dark font-medium mb-3">
              {tagline}
            </p>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-2xl mb-6">
              {summary}
            </p>

            <!-- Botones de Acción -->
            <div class="flex flex-wrap items-center justify-center md:justify-start gap-4">
              <a
                href={app.apkUrl}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  'inline-flex items-center gap-2 px-6 py-3 rounded-2xl text-sm font-bold shadow-lg transition-all duration-200 active:scale-95',
                  cfg.btn,
                ]}
                id={`hero-download-${app.slug}`}
              >
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                {t.downloadApk}
              </a>
              <a
                href={`/${lang}/#apps`}
                class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl text-sm font-semibold bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700 text-zinc-700 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700 transition-all duration-200 active:scale-95"
              >
                ← {t.backToApps}
              </a>
            </div>
          </div>
        </div>
      </header>

      <!-- ═══════════════════════════════════════════ -->
      <!-- SECCIÓN 1: MANUAL DE FUNCIONALIDADES        -->
      <!-- ═══════════════════════════════════════════ -->
      <section class="mb-14">
        <div class="mb-8">
          <h2 class="text-2xl sm:text-3xl font-bold text-zinc-900 dark:text-white mb-2">
            {t.sectionManualTitle}
          </h2>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">
            {t.sectionManualSub}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {features.map((feat) => (
            <div class="p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800/80 hover:border-primary/50 transition-colors shadow-sm">
              <div class="text-2xl mb-3">{feat.icon}</div>
              <h3 class="text-base font-bold text-zinc-900 dark:text-white mb-2">{feat.title}</h3>
              <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">{feat.description}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- ═══════════════════════════════════════════ -->
      <!-- SECCIÓN 2: GUÍA PASO A PASO                 -->
      <!-- ═══════════════════════════════════════════ -->
      <section class="mb-14 p-8 rounded-3xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-sm">
        <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-6">
          {t.sectionStepsTitle}
        </h2>
        <div class="space-y-6">
          {manualSteps.map((step) => (
            <div class="flex items-start gap-4">
              <div class="w-9 h-9 rounded-xl bg-primary/10 dark:bg-primary/20 text-primary dark:text-primary-dark font-extrabold flex items-center justify-center flex-shrink-0 text-sm">
                {step.step}
              </div>
              <div>
                <h3 class="text-base font-bold text-zinc-900 dark:text-zinc-100 mb-1">{step.title}</h3>
                <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">{step.description}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ═══════════════════════════════════════════ -->
      <!-- SECCIÓN 3: ESTADO DE CUENTA Y PRIVACIDAD    -->
      <!-- ═══════════════════════════════════════════ -->
      <section class="mb-14 p-8 rounded-3xl bg-gradient-to-br from-zinc-50 to-zinc-100 dark:from-zinc-900 dark:to-zinc-900/80 border border-zinc-200 dark:border-zinc-800">
        <div class="flex items-center gap-3 mb-4">
          <div class:list={[
            'w-10 h-10 rounded-xl flex items-center justify-center text-lg',
            app.hasAccountOption ? 'bg-blue-100 dark:bg-blue-900/40 text-blue-600' : 'bg-emerald-100 dark:bg-emerald-900/40 text-emerald-600',
          ]}>
            {app.hasAccountOption ? '☁️' : '🔒'}
          </div>
          <div>
            <h2 class="text-xl font-bold text-zinc-900 dark:text-white">
              {t.sectionAccountTitle}
            </h2>
            <span class="text-xs font-semibold uppercase tracking-wider text-zinc-500">
              {app.hasAccountOption ? t.cloudSyncHeading : t.noAccountHeading}
            </span>
          </div>
        </div>

        <p class="text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed mb-4">
          {accountExplanation}
        </p>

        <div class="p-4 rounded-xl bg-white dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700 text-xs text-zinc-600 dark:text-zinc-400 flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span>{t.permissionSafe}</span>
        </div>
      </section>

      <!-- ═══════════════════════════════════════════ -->
      <!-- SECCIÓN 4: PERMISOS Y ESPECIFICACIONES      -->
      <!-- ═══════════════════════════════════════════ -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
        <!-- Permisos -->
        <div class="p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="text-lg font-bold text-zinc-900 dark:text-white mb-4 flex items-center gap-2">
            <span>🛡️</span> {t.sectionPermissionsTitle}
          </h3>
          <div class="space-y-3">
            {permissions.map((perm) => (
              <div class="text-xs">
                <div class="font-bold text-zinc-800 dark:text-zinc-200 mb-0.5">{perm.name}</div>
                <div class="text-zinc-500 dark:text-zinc-400 leading-relaxed">{perm.usage}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- Especificaciones Técnicas -->
        <div class="p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
          <h3 class="text-lg font-bold text-zinc-900 dark:text-white mb-4 flex items-center gap-2">
            <span>⚙️</span> {t.sectionSpecsTitle}
          </h3>
          <dl class="space-y-3">
            {app.technicalSpecs.map((spec) => (
              <div class="flex items-center justify-between text-xs py-1 border-b border-zinc-100 dark:border-zinc-800/80 last:border-0">
                <dt class="text-zinc-500 dark:text-zinc-400 font-medium">{spec.label}:</dt>
                <dd class="text-zinc-900 dark:text-zinc-100 font-semibold">{spec.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>

      <!-- ═══════════════════════════════════════════ -->
      <!-- APPS RELACIONADAS                           -->
      <!-- ═══════════════════════════════════════════ -->
      {relatedApps.length > 0 && (
        <section class="pt-8 border-t border-zinc-200 dark:border-zinc-800">
          <div class="flex items-center justify-between mb-6">
            <h3 class="text-lg font-bold text-zinc-900 dark:text-white">
              {t.relatedAppsTitle} {cfg.label}
            </h3>
            <a href={`/${lang}/#apps`} class="text-xs font-semibold text-primary dark:text-primary-dark hover:underline">
              {t.backToApps} ➔
            </a>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            {relatedApps.slice(0, 4).map((rel) => (
              <a
                href={`/${lang}/apps/${rel.slug}`}
                class="p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-primary/50 transition-all text-center group"
              >
                <img
                  src={rel.iconUrl}
                  alt={rel.name}
                  class="w-14 h-14 mx-auto rounded-xl object-contain drop-shadow-md mb-2 group-hover:scale-105 transition-transform"
                  loading="lazy"
                />
                <div class="text-xs font-bold text-zinc-900 dark:text-white truncate">{rel.name}</div>
                <div class="text-[10px] text-zinc-500 dark:text-zinc-400 mt-1">
                  {rel.hasAccountOption ? (isEn ? 'Optional Account' : 'Cuenta Opcional') : (isEn ? 'No Account' : 'Sin Cuenta')}
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

    </div>
  </main>
</Layout>
