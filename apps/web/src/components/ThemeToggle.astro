---
// ThemeToggle.astro — Dark/Light mode toggle with localStorage persistence
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle dark mode"
  aria-pressed="false"
  onclick="window.__toggleTheme && window.__toggleTheme()"
  class="relative w-10 h-10 flex items-center justify-center rounded-xl text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-primary/50 cursor-pointer pointer-events-auto"
>
  <!-- Sun icon (shown in dark mode: clicking switches to light) -->
  <svg
    id="icon-sun"
    xmlns="http://www.w3.org/2000/svg"
    class="w-5 h-5 hidden dark:block pointer-events-none transition-transform duration-300 text-amber-400"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <circle cx="12" cy="12" r="5" />
    <line x1="12" y1="1" x2="12" y2="3" />
    <line x1="12" y1="21" x2="12" y2="23" />
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
    <line x1="1" y1="12" x2="3" y2="12" />
    <line x1="21" y1="12" x2="23" y2="12" />
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
  </svg>

  <!-- Moon icon (shown in light mode: clicking switches to dark) -->
  <svg
    id="icon-moon"
    xmlns="http://www.w3.org/2000/svg"
    class="w-5 h-5 block dark:hidden pointer-events-none transition-transform duration-300 text-zinc-700"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
  </svg>
</button>

<script is:inline>
  (function() {
    var btn = document.getElementById('theme-toggle');
    if (btn) {
      btn.onclick = function(e) {
        if (e) e.preventDefault();
        if (typeof window.__toggleTheme === 'function') {
          window.__toggleTheme();
        }
      };
      var isDark = document.documentElement.classList.contains('dark');
      btn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
    }
  })();
</script>
