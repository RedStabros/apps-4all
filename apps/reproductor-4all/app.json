{
  "expo": {
    "name": "Reproductor 4All",
    "slug": "reproductor-4all",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.apps4all.reproductor4all",
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Permite acceder y reproducir tus archivos de audio locales sin conexión."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#09090b"
      },
      "package": "com.apps4all.reproductor4all",
      "permissions": [
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "plugins": [
      "./plugins/withAudioEngine",
      "./plugins/withReleaseSigning"
    ]
  }
}
